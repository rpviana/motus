generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MobilityEvent {
  id           String   @id @default(cuid())
  event        String
  mobilityType String?
  zone         String?
  command      String?
  confidence   Float?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}
