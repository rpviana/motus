DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/motus?sslmode=require"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
VITE_API_URL="http://localhost:4000"

# Use "mock" for local demos without an API token, "roboflow" for the trained Motus model,
# or "huggingface" for a generic online provider.
VISION_PROVIDER="mock"

ROBOFLOW_API_KEY=""
ROBOFLOW_MODEL_URL="https://serverless.roboflow.com/motus-accessibility/2"

HUGGING_FACE_API_TOKEN=""
HUGGING_FACE_MODEL="facebook/detr-resnet-50"

FRAME_PROCESS_INTERVAL_MS=1200
